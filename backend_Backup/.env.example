# QoraQot CRM — Backend Configuration
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ MySQL ของคุณ

# ===== MySQL Database =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=        # ใส่รหัสผ่าน MySQL ของคุณที่นี่ (ถ้า XAMPP ค่า default คือว่างเปล่า)
DB_NAME=qoraqot_crm

# ===== JWT Secret Key =====
# เปลี่ยนเป็นสตริงสุ่มยาวๆ อย่างน้อย 32 ตัวอักษร (ห้ามใช้ค่านี้ใน Production)
JWT_SECRET=qoraqot_crm_super_secret_key_change_this_in_production_2024
JWT_EXPIRES_IN=8h

# ===== Server =====
PORT=3001
NODE_ENV=development

# ===== CORS — อนุญาต Frontend ที่รันอยู่บน localhost =====
CLIENT_URL=http://localhost:5173
